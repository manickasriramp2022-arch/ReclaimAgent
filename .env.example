# ReclaimAgent - example environment file. Copy to .env and fill in locally.
# NEVER commit a real key. .env is git-ignored.

# Only needed for the LLM classifier fallback (`reclaim run` without --no-llm).
# The full pipeline runs offline with `--no-llm`, which uses the rule layer only.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: override the model used for the classifier fallback.
RECLAIM_LLM_MODEL=claude-sonnet-5
